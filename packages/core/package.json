{
  "name": "@gestures/core",
  "version": "0.1.0-alpha.0",
  "description": "Modern multi-touch and pointer gesture recognition library for the web",
  "license": "MIT",
  "author": "Jorik Tangelder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtangelder/gestures.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jtangelder/gestures#readme",
  "bugs": {
    "url": "https://github.com/jtangelder/gestures/issues"
  },
  "keywords": [
    "gestures",
    "touch",
    "pointer-events",
    "multitouch",
    "pan",
    "swipe",
    "pinch",
    "zoom",
    "rotate",
    "tap"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:watch": "tsc --emitDeclarationOnly --watch & vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/gestures.es.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ]
}
