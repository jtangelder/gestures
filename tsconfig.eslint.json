{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true,
    "paths": {
      "@gestures/core": ["./packages/core/src/index.ts"],
      "@gestures/trackpad": ["./packages/trackpad/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "packages/*/vite*.config.ts",
    "playground/**/*"
  ]
}
