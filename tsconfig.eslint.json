{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "paths": {
      "@gestures/core": ["./packages/core/src/index.ts"],
      "@gestures/react": ["./packages/react/src/index.ts"],
      "@gestures/react/trackpad": ["./packages/react/src/trackpad.ts"],
      "@gestures/trackpad": ["./packages/trackpad/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "packages/*/vite*.config.ts",
    "site/**/*"
  ]
}
