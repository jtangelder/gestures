{
  "name": "gestures-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "npm -w @gestures/core run build && npm -w @gestures/trackpad run build && npm --workspaces --if-present run build",
    "build:site": "vite build --config site/vite.config.ts",
    "size": "node scripts/check-size.mjs",
    "test": "npm --workspaces --if-present run test && npm run test:site",
    "test:unit": "npm --workspaces --if-present run test:unit && npm run test:site",
    "test:site": "vitest run --config site/vite.config.ts",
    "test:browser": "npm -w @gestures/core run test:browser",
    "test:coverage": "npm -w @gestures/core run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "gts lint",
    "lint:fix": "gts fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "pretest": "npm run build",
    "posttest": "npm run lint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.9",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "gts": "^7.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "sugar-high": "^2.7.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
